      "source": [
        "# Basic Linear Regression with Scikit-Learn\n",
        "This notebook demonstrates how to create, train, and visualize a simple Linear Regression model using the pre-installed `scikit-learn` and `matplotlib` libraries."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ca730021",
        "outputId": "8db3ac1b-2245-4108-dc4a-2b041aaedddf"
      },
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "# 1. Generate some synthetic data\n",
        "np.random.seed(42)\n",
        "X = 2 * np.random.rand(100, 1)\n",
        "y = 4 + 3 * X + np.random.randn(100, 1)\n",
        "\n",
        "# 2. Initialize and fit the model\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "# 3. Print the intercept and coefficient\n",
        "print(f\"Intercept: {model.intercept_[0]:.4f}\")\n",
        "print(f\"Coefficient: {model.coef_[0][0]:.4f}\")"
      ],
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Intercept: 4.2151\n",
            "Coefficient: 2.7701\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 564
        },
        "id": "8c826f0e",
        "outputId": "16c1d269-bc24-46d1-c022-17fc90286472"
      },
      "source": [
        "# 4. Make predictions and plot the results\n",
        "X_new = np.array([[0], [2]])\n",
        "y_predict = model.predict(X_new)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.scatter(X, y, color='blue', alpha=0.7, label='Data points')\n",
        "plt.plot(X_new, y_predict, color='red', linewidth=2, label='Regression Line')\n",
        "plt.xlabel('X')\n",
        "plt.ylabel('y')\n",
        "plt.title('Simple Linear Regression Demo')\n",
        "plt.legend()\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "plt.show()"
      ],
