      "source": [
        "temp_dataset['time'] = pd.to_datetime(temp_dataset['interval_start_utc'])\n",
        "load_dataset['time'] = pd.to_datetime(load_dataset['interval_start_utc'])\n",
        "zone = ['coast', 'east', 'far_west', 'north', 'north_central', 'south_central', 'southern', 'west']\n",
        "temp_dataset['system_temp'] = temp_dataset[zone].mean(axis=1)\n",
        "load_dataset['total_load'] = load_dataset[zone].sum(axis=1)\n",
        "Actual_Dataset = pd.merge(\n",
        "    load_dataset[['time', 'total_load']],\n",
        "    temp_dataset[['time', 'system_temp']],\n",
        "    on='time'\n",
        ").sort_values('time').reset_index(drop=True)\n",
        "Actual_Dataset = Actual_Dataset.set_index('time')\n",
        "Actual_Dataset['hour'] = Actual_Dataset.index.hour\n",
        "Actual_Dataset['day_of_week'] = Actual_Dataset.index.dayofweek\n",
        "\n",
        "if Actual_Dataset.index.tz is None:\n",
        "    Actual_Dataset.index = Actual_Dataset.index.tz_localize('UTC')\n",
        "start = pd.to_datetime(\"2021-02-14 00:00:00+00:00\")\n",
        "end = pd.to_datetime(\"2021-02-20 23:59:59+00:00\")\n",
        "\n",
        "train_df = Actual_Dataset[(Actual_Dataset.index < start) | (Actual_Dataset.index > end)].copy()\n",
        "test_df = Actual_Dataset[(Actual_Dataset.index >= start) & (Actual_Dataset.index <= end)].copy()\n",
        "y_train = train_df['total_load']\n",
        "y_test = test_df['total_load']"
      ],
      "metadata": {
        "id": "H6ln9NrL3wAC"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "features = ['system_temp', 'hour', 'day_of_week']\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('temp_scaler', StandardScaler(), ['system_temp']),\n",
        "        ('onehot_hour', OneHotEncoder(handle_unknown='ignore', sparse_output=False), ['hour']),\n",
        "        ('onehot_day', OneHotEncoder(handle_unknown='ignore', sparse_output=False), ['day_of_week'])\n",
        "    ],\n",
        "    remainder='drop'\n",
        ")\n",
        "X_train = preprocessor.fit_transform(train_df[features])\n",
        "X_test = preprocessor.transform(test_df[features])\n",
        "hour = preprocessor.named_transformers_['onehot_hour'].get_feature_names_out(['hour'])\n",
        "day = preprocessor.named_transformers_['onehot_day'].get_feature_names_out(['day_of_week'])\n",
        "names = ['system_temp_scaled'] + list(hour) + list(day)\n",
        "X_train_df = pd.DataFrame(X_train, columns=names, index=train_df.index)\n",
        "X_test_df = pd.DataFrame(X_test, columns=names, index=test_df.index)\n",
        "for col in hour:\n",
        "    X_train_df[f'temp_x_{col}'] = X_train_df['system_temp_scaled'] * X_train_df[col]\n",
        "    X_test_df[f'temp_x_{col}'] = X_test_df['system_temp_scaled'] * X_test_df[col]\n",
        "model = SGDRegressor(penalty='l2', max_iter=2000, tol=1e-3, random_state=42)\n",
        "model.fit(X_train_df, y_train)\n"
      ],
